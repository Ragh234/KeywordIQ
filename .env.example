# Root .env, loaded by server/index.js via:
#   dotenv.config({ path: path.join(__dirname, "..", ".env") })
# i.e. this file belongs at the project root, not inside server/.

# MongoDB connection string used by server/config/db.js
MONGO_URI=mongodb://localhost:27017/keywordiq

# Secret used to sign/verify JWTs (server/controllers/authController.js,
# server/middleware/auth.js). Use a long random string in any real deployment.
JWT_SECRET=change_this_to_a_long_random_string

# Express server port (server/index.js). Optional, defaults to 5000.
PORT=5000

# Where the Express API proxies analysis requests to
# (server/controllers/keywordController.js). Optional, defaults to
# http://127.0.0.1:8000 — the FastAPI service started with:
#   uvicorn api.main:app --reload --port 8000
PYTHON_API_URL=http://127.0.0.1:8000
